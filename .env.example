PORT=3000
HOST=0.0.0.0
NODE_ENV=production
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-SECRET-64-CHARS-MIN
DB_FILE=./data/doitforme.sqlite

# Public HTTPS origin (required for payments, GPS, push, APK/TWA)
APP_BASE_URL=https://app.yourdomain.com

# Mapbox (optional — traffic-aware routes)
MAPBOX_ACCESS_TOKEN=
MAPBOX_PROFILE=mapbox/driving-traffic
ROUTE_RECALC_METERS=100
ROUTE_REFRESH_SECONDS=30

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# Termii OTP / SMS
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=DOITFORME
TERMII_CHANNEL=generic
OTP_DEV_MODE=false

# OneSignal web/push
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=
